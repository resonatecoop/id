extends layout

block header
  include header

block content
  :go:func
    PasswordResetUpdatePassword(
      isDevelopment bool,
      version,
      path,
      query,
      csrfField,
      title,
      description string,
      profile *Profile,
      flash *session.Flash,
      fragment string,
      state *InitialState,
      token string
    )

  if flash.Message != ""
    .sticky.top-0.z-999.mb3.flex
      p.ma0.pa3.w-100 #{flash.Message}

  .flex.flex-column.flex-auto.items-center.justify-center.min-vh-100.mh3.pt6.pb6
    .flex.flex-column.w-100.w-auto-l.ph4.pt4.pb3
      h2.f3.fw1.mt3.near-black.near-black--light.light-gray--dark.lh-title Reset your password
      .flex.flex-column.flex-auto
        .flex.flex-column.flex-auto
          form.flex.flex-column.flex-auto(action='' method='POST')
            !=csrfField
            input(type='hidden' name='_method' value='PUT')
            input(type='hidden' name='token' value=token)
            div
              .flex.flex-column.mb3
                .flex.flex-column.flex-column-reverse
                  input#password_new.bg-black.white.bg-white--dark.black--dark.bg-black--light.white--light.placeholder--dark-gray.input-reset.w-100.bn.pa3.valid(value='' autocomplete='false' type='password' name='password_new' placeholder='New password' required='required')
              .flex.flex-column.mb3
                .flex.flex-column.flex-column-reverse
                  input#password_confirm.bg-black.white.bg-white--dark.black--dark.bg-black--light.white--light.placeholder--dark-gray.input-reset.w-100.bn.pa3.valid(value='' autocomplete='false' type='password' name='password_confirm' placeholder='Password confirmation' required='required')
            .flex.mt3
              .flex.mr3
              .flex.flex-auto.justify-end.pr1
                button.bg-white.black.bg-black--dark.near-white--dark.dib.pv3.ph5.flex-shrink-0.f5.grow.ba.bw.b--near-black.b--dark-gray--dark(type='submit')
                  | Update password

block footer
  include footer
