extends layout

block header
  include header

block content
  :go:func
    Join(
      isDevelopment bool,
      path,
      query,
      csrfField,
      title,
      description string,
      profile *Profile,
      flash *session.Flash,
      fragment string,
      state *InitialState
    )

  if flash.Message != ""
    .sticky.top-0.z-999.mb3.flex(class='')
      p.ma0.pa3.w-100 #{flash.Message}

  .flex.pb6
    .flex.flex-column.justify-center.items-center.w-100.min-vh-100
      .flex.flex-column.flex-auto.mt4.pt4.ph3.ph0-l
        p.lh-copy.f4
          | We are currently pausing new signups in order to work on our system.
        p.lh-copy.f4
          | To find out more, please visit the forums at&nbsp;
          a(href='https://community.resonate.coop') community.resonate.coop
          | .
        p.lh-copy.f4
          | If you do have an account, you can&nbsp;
          a(href='/login') log in
          | &nbsp;to update your account details.

block footer
  include footer
