    meta(name='theme-color' content='#ffffff')
    style.
      [x-cloak] { display: none !important; }
    if isDevelopment
      script.
        new EventSource('https://localhost:8000/esbuild').addEventListener('change', () => location.reload())
      //link(rel='stylesheet' href='https://unpkg.com/tachyons@4.12.0/css/tachyons.css')
      //link(rel='stylesheet' href='https://localhost:8000/css/main.min.css')
      script(type='text/javascript' async='' defer='' src='https://localhost:8000/js/main.js?v='+version)
      link(href='https://localhost:8000/css/main.css?v='+version rel='stylesheet')
    else
      link(rel='stylesheet' href='/css/main.css?v='+version)
      script(type='text/javascript' async='' defer='' src='/js/main.min.js?v='+version)
