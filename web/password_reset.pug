extends layout

block header
  include header

block content
  :go:func
    PasswordReset(
      isDevelopment bool,
      path,
      query,
      csrfField,
      title,
      description string,
      profile *Profile,
      flash *session.Flash,
      fragment string,
      state *InitialState
    )

  if flash.Message != ""
    .sticky.top-0.z-999.mb3.flex
      p.ma0.pa3.w-100 #{flash.Message}

  .flex.flex-column.flex-auto.items-center.justify-center.min-vh-100.mh3.pt6.pb6
    .flex.flex-column.w-100.w-auto-l.ph4.pt4.pb3
      h2.f3.fw1.mt3.near-black.near-black--light.light-gray--dark.lh-title Reset your password
      .flex.flex-column.flex-auto
        .flex.flex-column.flex-auto
          form#password.flex.flex-column.flex-auto.ma0.pa0(action='' method='POST')
            !=csrfField
            div
              .flex.flex-column.mb3
                label.f5.db.mb1(for='email')
                  | To reset your password, please enter your email address below.
                  br
                  | Please note that the email may take up to 20 minutes to arrive.
                .relative
                  input#email.bg-black.white.bg-white--dark.black--dark.bg-black--light.white--light.placeholder--dark-gray.input-reset.w-100.bn.pa3.valid(value='' autocomplete='false' type='email' name='email' placeholder='Enter your email address' required='required')
            .flex.mt3
              .flex.mr3
                .flex.flex-auto.justify-end.pr1
                  button.bg-white.black.bg-black--dark.near-white--dark.dib.pv3.ph5.flex-shrink-0.f5.grow.ba.bw.b--near-black.b--dark-gray--dark(type='submit')
                    | Reset my password

block footer
  include footer
